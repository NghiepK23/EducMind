# Sao chép thành .env rồi điền giá trị thật. Không commit .env.

# --- Database (khớp docker-compose.yml) ---
DB_URL=jdbc:postgresql://localhost:5432/educmind
DB_USER=educmind
DB_PASSWORD=educmind_dev

# --- Bảo mật ---
# BẮT BUỘC đổi ở production, tối thiểu 32 byte
JWT_SECRET=dev-only-secret-0123456789abcdef0123456789abcdef-change-in-production
JWT_TTL_MINUTES=60

# --- Email đặt lại mật khẩu ---
FRONT_URL=http://localhost:5173
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# --- Lưu tài liệu tải lên ---
STORAGE_PATH=./storage/resources

# --- Dev ---
EDUCMIND_SEED=false
JPA_SHOW_SQL=false
